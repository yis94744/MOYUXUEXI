# 统一换行符：仓库内一律 LF，检出时按平台转换
* text=auto eol=lf

# 文本文件
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.ps1   text eol=lf

# 二进制（不转换）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary